<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/booking.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <title>Booking</title>
</head>
<body>
    <video id="background-video" autoplay loop muted>
        <source src="/img/city.mp4" type="video/mp4">
      </video>
     <div class="signup">
        <form action="/booking" method="post">
            <a href="/westin"><svg id="backward" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg></a>
            <h1>Westin Hotel <br> Booking In</h1>
            <div class="input-box1">
                <input type="text" name = "firstname" placeholder="firstname" required> <input type="text" name = "lastname" placeholder="Lastname" required>
            </div>
            <div class="input-box1">
                <input type="number" name = "age" placeholder="Age" required>  <input type="number" name = "guest" placeholder="Number of guest" required>
            </div>
            <div class="input-box1">
                <input type="text" id = "bed" name = "bed" value="" required>  <input type="text" id = "room" name = "room" value="" required>
            </div>
            <div class="input-box2">
                <input id = "startDate" name = "CheckIn" type="date" required><span> To </span>  <input id = "endDate" name = "CheckOut" type="date"required>
            </div>
            <div class="input-box3">
                <input type="email" name = "email" placeholder="Email" required>
            </div>
            <div class="input-box3">
                <input type="text" name = "Mobile" placeholder="Mobile phone" required>
            </div>
            <div class="input-box3">
                <input type="text" id = "total" name = "price" value="" required>
            </div>
            <div class="btn1">
                <button type = "submit" id = "btn1">Book</button></a>
            </div>
        </form>
     </div>
</body>
</html>
<script src="/index.js"></script>

 